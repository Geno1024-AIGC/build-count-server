[Unit]
Description=Build count HTTP server
After=network.target

[Service]
Type=simple
User=buildcount
WorkingDirectory=/opt/build-count-server
Environment=BIND=0.0.0.0
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/build-count-server
EnvironmentFile=/etc/build-count-server.env
ExecStart=/usr/bin/java -cp /opt/build-count-server/out/main com.geno1024.ai.buildcount.Main
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/build-count-server

[Install]
WantedBy=multi-user.target
